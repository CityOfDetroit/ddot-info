# Postgres connection to the GTFS database (PostGIS + functions.sql loaded).
# Be explicit about host/port: `postgres:///transit` resolves to localhost:5432 in
# node-postgres, so a stray container on 5432 silently becomes your GTFS database.
PG_CONN=postgres://user@localhost:5432/transit

# Swiftly realtime API (https://docs.goswift.ly). SWIFTLY_AGENCY is the path segment
# after dashboard.goswift.ly/ in the Swiftly dashboard URL.
# NOTE: the key is rate limited to 180 requests / 15 min, shared across the whole key.
# Only the parameterless feed-* functions may call Swiftly directly.
SWIFTLY_KEY=
SWIFTLY_AGENCY=
